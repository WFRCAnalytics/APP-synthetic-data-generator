{
  "name": "synthetic-data-generator",
  "private": true,
  "version": "0.4.0",
  "description": "Client-side synthetic data generator for AI coding agents (WFRC)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/copy-duckdb.mjs && node scripts/fetch-extensions.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-duckdb.mjs && node scripts/fetch-extensions.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:browsers": "node scripts/e2e-browsers.mjs",
    "release": "npm run build && node scripts/build-release.mjs",
    "verify:release": "node scripts/verify-release.mjs",
    "test:e2e:offline": "playwright test offline-zip offline-guard",
    "fixtures": "node scripts/make-fixtures.mjs",
    "verify:roundtrip": "node scripts/verify-roundtrip.mjs",
    "build:spike": "node scripts/copy-duckdb.mjs && node scripts/fetch-extensions.mjs && vite build --mode spike"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@faker-js/faker": "^10.6.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.25",
    "lucide-react": "^1.66.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^24.0.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.14.0",
    "jsdom": "^30.1.3",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
