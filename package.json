{
  "name": "synthetic-data-generator",
  "private": true,
  "version": "0.1.0",
  "description": "Client-side synthetic data generator for AI coding agents (WFRC)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "predev": "node scripts/copy-duckdb.mjs && node scripts/fetch-extensions.mjs",
    "dev": "vite",
    "prebuild": "node scripts/copy-duckdb.mjs && node scripts/fetch-extensions.mjs",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:browsers": "node scripts/e2e-browsers.mjs",
    "fixtures": "node scripts/make-fixtures.mjs",
    "verify:roundtrip": "node scripts/verify-roundtrip.mjs",
    "build:spike": "node scripts/copy-duckdb.mjs && node scripts/fetch-extensions.mjs && vite build --mode spike"
  },
  "dependencies": {
    "@duckdb/duckdb-wasm": "1.33.1-dev57.0",
    "@faker-js/faker": "^10.6.0",
    "@fontsource/fira-code": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/poppins": "^5.3.0",
    "@tanstack/react-virtual": "^3.14.24",
    "lucide-react": "^1.65.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "valibot": "^1.5.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@testing-library/jest-dom": "^6.4.8",
    "@testing-library/react": "^16.0.0",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^20.19.43",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^4.7.0",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "eslint-plugin-react-refresh": "^0.4.9",
    "jsdom": "^24.1.1",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "vite": "^5.4.21",
    "vitest": "^2.1.9"
  },
  "allowScripts": {
    "esbuild@0.21.5": true
  }
}
